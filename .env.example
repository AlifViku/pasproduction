# Google Gemini Flash API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
# Catatan: API Key juga dapat diatur langsung lewat antarmuka aplikasi (Modal Pengaturan AI)
VITE_GEMINI_API_KEY=

# Fonnte WhatsApp Gateway API Token (https://fonnte.com)
# Catatan: Token dan No. WhatsApp Admin juga dapat diatur melalui menu Pengaturan Admin
VITE_FONNTE_TOKEN=
VITE_ADMIN_WHATSAPP=
